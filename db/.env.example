# Web/backend settings: copy the relevant entries to apps/web/.env.local.
# Never commit real env files or put server secrets in NEXT_PUBLIC_ variables.
MONGODB_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER/drift?retryWrites=true&w=majority&appName=Drift
MONGODB_DB=drift
CLERK_PUBLISHABLE_KEY=
# Existing NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is also accepted.
CLERK_SECRET_KEY=
DRIFT_APP_ORIGIN=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=drift-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Shared worker/backend settings: put these in the root .env.
TRACKING_INGEST_SECRET=
DRIFT_API_BASE_URL=http://localhost:3000
DRIFT_DATASET_ID=troy-demo
SMOKE_AUTH_TOKEN=
