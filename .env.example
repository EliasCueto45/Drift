# Private settings: root .env and apps/web/.env.local are ignored by Git.
MONGODB_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER/drift?retryWrites=true&w=majority
MONGODB_DB=drift
# Existing NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is also accepted.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DRIFT_APP_ORIGIN=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=drift-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TRACKING_INGEST_SECRET=
DRIFT_DATASET_ID=troy-demo
DRIFT_API_BASE_URL=http://localhost:3000
# Optional real Clerk session JWT for signed-in smoke checks.
SMOKE_AUTH_TOKEN=
