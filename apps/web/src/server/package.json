{
  "name": "@drift/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs test/database.integration.mjs",
    "test:db": "node --test test/database.integration.mjs",
    "db:migrate": "node ../../../../db/migrate.mjs",
    "db:seed": "node ../../../../db/seed.mjs",
    "cleanup": "node cleanup-cli.mjs",
    "lint": "node check.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@clerk/nextjs": "^6.35.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "music-metadata": "^11.10.0",
    "pg": "^8.16.3",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-postgis": "^0.2.15",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
